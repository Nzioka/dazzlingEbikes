{
  // Dazzling E-Bikes demo store: runs entirely on Cloudflare.
  // Workers (code) + Static Assets (storefront) + D1 (data) + R2 and Vectorize (repair manuals)
  // + Workers AI and AI Gateway (assistant) + Turnstile (bot check) + Access (/admin).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dazzling-shop",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // Logs plus traces. Traces sample every request (head_sampling_rate defaults to 1)
  // and carry the Rider Assistant's agent spans (metadata only, no message text).
  "observability": { "enabled": true, "traces": { "enabled": true } },

  // Smart Placement: Cloudflare may run the Worker code near the database when that
  // is faster. Static assets are still served from the city closest to the visitor.
  "placement": { "mode": "smart" },

  // Storefront HTML, CSS, JS and images are served straight from the edge.
  // Anything that is not a file (/api/*, /admin) runs the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },

  // Serve on your own domain so WAF, rate limiting and Access all apply.
  // Change nzioka.dev if you use another zone.
  "routes": [{ "pattern": "shop.nzioka.dev", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dazzling-shop",
      "database_id": "150bbc38-4910-4250-9de3-2b0f0fc5b9ae",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI powers the Rider Assistant (/api/assistant). No API keys needed.
  "ai": { "binding": "AI" },

  // Repair manuals: the Markdown files live in R2, their embeddings in Vectorize.
  // Admin → "Reindex manuals" rebuilds the index from whatever is in the bucket.
  "r2_buckets": [{ "binding": "MANUALS", "bucket_name": "dazzling-manuals", "remote": true }],
  "vectorize": [{ "binding": "VECTORS", "index_name": "dazzling-manuals", "remote": true }],

  // Per-IP limit on assistant questions, so nobody can run up the AI bill.
  "ratelimits": [
    { "name": "ASSISTANT_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    // AI Gateway that logs assistant calls (prompts, latency, cost). "default" is created automatically.
    "AI_GATEWAY_ID": "default",
    // Turnstile widget for shop.nzioka.dev (public). The secret is a Worker secret:
    // TURNSTILE_SECRET. For local dev, .dev.vars overrides this with the test key.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGM202n18HURxdi7",
    // Your Zero Trust team domain and the Access application AUD tag, for /admin.
    "ACCESS_TEAM_DOMAIN": "nzioka.cloudflareaccess.com",
    "ACCESS_AUD": "b405d4b55bb366c795223d6db8bd98d7287a6f88611d52e3506827f901a7e081"
  }
  // Secret, set with: npx wrangler secret put TURNSTILE_SECRET
}
